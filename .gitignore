# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini

# editors — personal setup, not project configuration
.vscode/
.idea/
*.swp

# Claude Code: `launch.json` describes how to start this project and is shared;
# `settings.local.json` is one machine's permission list and is not.
.claude/settings.local.json

# Key and certificate material. The app parses certificates entirely in the
# browser and never needs a file on disk, so anything matching here got dropped
# in the working tree by hand — a sample to inspect, or worse, a real key. The
# test fixtures are generated in code (`tests/fixtures/factory.ts`), so nothing
# the repository actually needs is caught by these.
*.pem
*.key
*.crt
*.cer
*.der
*.p7b
*.p12
*.pfx
*.csr

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except this one: it only disables Next.js build telemetry and belongs in
# the repository, since the app promises to collect nothing.
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
# Regenerated by `next dev`, `next build` and `next typegen`; Next.js documents
# it as an implementation detail that should not be tracked. `npm run typecheck`
# passes on a fresh clone without it.
next-env.d.ts
